{
  "max_ttl_seconds": 86400,
  "default": {
    "max_ttl_seconds": 600
  },
  "rules": [
    {
      "scope": "read",
      "max_ttl_seconds": 3600
    },
    {
      "scope": "write",
      "max_ttl_seconds": 1800
    },
    {
      "scope": "read:admin",
      "max_ttl_seconds": 300
    },
    {
      "scope": "billing:*",
      "max_ttl_seconds": 120
    }
  ]
}
