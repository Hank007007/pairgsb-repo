{
  "roles": {
    "reader": {
      "rules": [
        {"actions": ["read"], "resources": ["docs/*"]}
      ]
    },
    "writer": {
      "rules": [
        {"actions": ["write"], "resources": ["docs/*"]}
      ]
    },
    "ops": {
      "rules": [
        {"actions": ["write"], "resources": ["docs/private/*"], "deny": true}
      ]
    },
    "analyst": {
      "rules": [
        {"actions": ["read"], "resources": ["audit/a"]}
      ]
    }
  },
  "inherits": {
    "writer": ["reader"],
    "ops": ["writer"]
  },
  "bindings": {
    "alice": ["ops", "analyst"],
    "bob": ["reader"]
  },
  "principals": ["alice", "bob"]
}
