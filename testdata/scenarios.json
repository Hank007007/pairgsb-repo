{
  "scenarios": [
    {
      "name": "escaped-slash-key",
      "note": "policy §2: a~1b is the key a/b",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "metadata": {
          "a/b": "old",
          "plain": "x"
        }
      },
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/a~1b",
          "value": "new"
        }
      ]
    },
    {
      "name": "escaped-tilde-key",
      "note": "policy §2: a~0b is the key a~b",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "metadata": {
          "a~b": "old"
        }
      },
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/a~0b",
          "value": "new"
        }
      ]
    },
    {
      "name": "escaped-tilde-one-key",
      "note": "policy §2: ~01 decodes to the literal key ~1",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "metadata": {
          "~1": "old"
        }
      },
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/~01",
          "value": "new"
        }
      ]
    },
    {
      "name": "empty-key-nested",
      "note": "policy §2: /metadata/ addresses the empty key inside metadata",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "metadata": {
          "": "blank",
          "keep": "x"
        }
      },
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/",
          "value": "filled"
        }
      ]
    },
    {
      "name": "whole-document-pointer",
      "note": "policy §2: / addresses the top-level empty key, not the whole document",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "": "blank"
      },
      "patch": [
        {
          "op": "test",
          "path": "/",
          "value": "blank"
        }
      ]
    },
    {
      "name": "invalid-escape",
      "note": "policy §2: ~2 is a malformed escape",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "metadata": {
          "ti~2tle": "old"
        }
      },
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/ti~2tle",
          "value": "x"
        }
      ]
    },
    {
      "name": "trailing-tilde",
      "note": "policy §2: a trailing ~ is a malformed escape",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "metadata": {
          "note": "old"
        }
      },
      "patch": [
        {
          "op": "replace",
          "path": "/metadata/note~",
          "value": "x"
        }
      ]
    },
    {
      "name": "array-add-out-of-range",
      "note": "policy §3.1: add index must be at most len",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "tags": [
          "a",
          "b"
        ]
      },
      "patch": [
        {
          "op": "add",
          "path": "/tags/5",
          "value": "z"
        }
      ]
    },
    {
      "name": "array-add-insert",
      "note": "policy §3.1: add at index 1 shifts later elements right",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "tags": [
          "a",
          "b"
        ]
      },
      "patch": [
        {
          "op": "add",
          "path": "/tags/1",
          "value": "m"
        }
      ]
    },
    {
      "name": "array-add-append",
      "note": "policy §3.1: - appends",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "tags": [
          "a",
          "b"
        ]
      },
      "patch": [
        {
          "op": "add",
          "path": "/tags/-",
          "value": "z"
        }
      ]
    },
    {
      "name": "array-negative-index",
      "note": "policy §2: a negative index is not a valid array index",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "tags": [
          "a",
          "b"
        ]
      },
      "patch": [
        {
          "op": "test",
          "path": "/tags/-1",
          "value": null
        }
      ]
    },
    {
      "name": "array-index-out-of-range",
      "note": "policy §2: an index beyond the array yields index-out-of-range",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "tags": [
          "a",
          "b"
        ]
      },
      "patch": [
        {
          "op": "test",
          "path": "/tags/5",
          "value": "z"
        }
      ]
    },
    {
      "name": "missing-member-target",
      "note": "policy §3.2: removing a member that does not exist is rejected",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft"
      },
      "patch": [
        {
          "op": "remove",
          "path": "/summary"
        }
      ]
    },
    {
      "name": "scalar-midpath",
      "note": "policy §2: traversal through a string is path-not-container",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "hello"
      },
      "patch": [
        {
          "op": "test",
          "path": "/title/length",
          "value": null
        }
      ]
    },
    {
      "name": "null-midpath",
      "note": "policy §2: traversal through null is path-not-container",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "metadata": null
      },
      "patch": [
        {
          "op": "test",
          "path": "/metadata/author",
          "value": null
        }
      ]
    },
    {
      "name": "move-into-descendant",
      "note": "policy §3.4: a move target below the source is rejected",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "metadata": {
          "a": {
            "b": 1
          }
        }
      },
      "patch": [
        {
          "op": "move",
          "from": "/metadata",
          "path": "/metadata/a/c"
        }
      ]
    },
    {
      "name": "move-onto-itself",
      "note": "policy §3.4: moving a location onto itself is permitted",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "same"
      },
      "patch": [
        {
          "op": "move",
          "from": "/title",
          "path": "/title"
        }
      ]
    },
    {
      "name": "unknown-op",
      "note": "policy §3: only the six listed operations are supported",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft"
      },
      "patch": [
        {
          "op": "merge",
          "path": "/title",
          "value": "x"
        }
      ]
    },
    {
      "name": "read-only-role",
      "note": "policy §4: role is read-only for every role",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "role": "user"
      },
      "patch": [
        {
          "op": "replace",
          "path": "/role",
          "value": "admin"
        }
      ]
    },
    {
      "name": "read-only-acl",
      "note": "policy §4: acl is read-only for every role",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "acl": [
          "read"
        ]
      },
      "patch": [
        {
          "op": "add",
          "path": "/acl/0",
          "value": "write"
        }
      ]
    },
    {
      "name": "read-only-tenant",
      "note": "policy §4: tenant_id is read-only for every role",
      "principal": {
        "role": "admin",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "tenant_id": "t1"
      },
      "patch": [
        {
          "op": "replace",
          "path": "/tenant_id",
          "value": "t2"
        }
      ]
    },
    {
      "name": "move-from-read-only",
      "note": "policy §4: move is rejected when from is read-only",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "role": "user"
      },
      "patch": [
        {
          "op": "move",
          "from": "/role",
          "path": "/summary"
        }
      ]
    },
    {
      "name": "viewer-denied",
      "note": "policy §4: viewer may not write title",
      "principal": {
        "role": "viewer",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft"
      },
      "patch": [
        {
          "op": "replace",
          "path": "/title",
          "value": "x"
        }
      ]
    },
    {
      "name": "editor-status-denied",
      "note": "policy §4: only admin may write status",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "draft",
        "status": "draft"
      },
      "patch": [
        {
          "op": "replace",
          "path": "/status",
          "value": "published"
        }
      ]
    },
    {
      "name": "atomic-rollback",
      "note": "policy §5: a failed test leaves the document unchanged",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "t",
        "count": 1
      },
      "patch": [
        {
          "op": "replace",
          "path": "/title",
          "value": "changed"
        },
        {
          "op": "test",
          "path": "/count",
          "value": 2
        }
      ]
    },
    {
      "name": "numeric-equality",
      "note": "policy §3.6: 1 and 1.0 compare equal",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "t",
        "count": 1
      },
      "patch": [
        {
          "op": "test",
          "path": "/count",
          "value": 1
        },
        {
          "op": "replace",
          "path": "/title",
          "value": "ok"
        }
      ]
    },
    {
      "name": "deep-copy",
      "note": "policy §3.5: a copied value is independent of its source",
      "principal": {
        "role": "editor",
        "tenant_id": "t1"
      },
      "document": {
        "id": "doc-1",
        "title": "t",
        "metadata": {
          "tags": [
            "a"
          ]
        }
      },
      "patch": [
        {
          "op": "copy",
          "from": "/metadata",
          "path": "/summary"
        },
        {
          "op": "replace",
          "path": "/summary/tags/0",
          "value": "b"
        }
      ]
    },
